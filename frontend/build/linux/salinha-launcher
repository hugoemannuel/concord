#!/bin/sh
# Lançador da Salinha instalada por usuário (sem FUSE, sem root):
#
#   <raiz>/versions/<versão>/   app (um .tar.gz assinado por versão)
#   <raiz>/current  -> versions/<versão>   (troca atômica a cada atualização)
#   <raiz>/previous -> versions/<anterior> (volta automática, ver abaixo)
#   <raiz>/bad-versions                    versões que não abriram (o app não
#                                          as oferece de novo)
#
# A raiz (padrão ~/.local/share/salinha) é deduzida do próprio caminho deste
# arquivo, que fica dentro de cada versão.
#
#   salinha-launcher [args...]   abre o app
#   salinha-launcher --integrate cria ~/.local/bin/salinha, o atalho do menu
#                                e o ícone (instalador e atualização chamam)
#
# Sandbox do Chromium: sem root não há o chrome-sandbox SUID, então o app usa
# o sandbox de user namespaces do kernel. Onde eles estão desligados (sysctl)
# ou restritos pelo AppArmor (Ubuntu 24.04+) sem o perfil da Salinha
# (/etc/apparmor.d/salinha, oferecido pelo install.sh), abre com --no-sandbox
# como último recurso, registra em <raiz>/launcher.log e exporta
# SALINHA_SANDBOX_OFF=<motivo> para o app avisar uma vez. SALINHA_SANDBOX=0/1
# força.
set -u

HERE=$(cd "$(dirname "$0")" && pwd -P) || exit 1
ROOT=$(dirname "$(dirname "$HERE")")
PROC_SYS="${SALINHA_PROC_SYS:-/proc/sys}"
APPARMOR_D="${SALINHA_APPARMOR_D:-/etc/apparmor.d}"
# Partidas da versão nova sem ela confirmar que abriu (o app apaga
# boot-pending após alguns segundos aberto). Depois de 2, a 3ª volta para a
# versão anterior.
FAILED_BOOTS=2

# Variáveis de um AppImage (terminal aberto dentro de outro AppImage) não são
# desta instalação: o app as usaria para escolher o updater errado.
unset APPIMAGE APPDIR ARGV0 OWD SALINHA_SANDBOX_OFF

log() {
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$*" >>"$ROOT/launcher.log" 2>/dev/null || true
}

# Aspas simples para shell: 'a'\''b'.
shquote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Argumento entre aspas no Exec do .desktop: \ " ` $ escapados (e \ de novo,
# pelo escape de strings do arquivo); % vira %%.
desktop_quote() {
  printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\\\\\/g' -e 's/[$`"]/\\\\&/g' -e 's/%/%%/g')"
}

abs_or() { # abs_or <valor> <padrão>: valor só se for caminho absoluto
  case "$1" in /*) printf '%s' "$1" ;; *) printf '%s' "$2" ;; esac
}

# Troca um link de forma atômica (mv -T por cima); sem -T, ln -sfn.
relink() { # relink <alvo> <link>
  tmp="$2.new.$$"
  if ln -s "$1" "$tmp" 2>/dev/null && mv -Tf "$tmp" "$2" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp"
  ln -sfn "$1" "$2"
}

# Guarda um arquivo que não é nosso (ex.: lançador do AppImage extraído) em
# <raiz>/legacy em vez de apagar.
backup_foreign() {
  [ -e "$1" ] || [ -L "$1" ] || return 0
  grep -q 'X-Salinha-Managed' "$1" 2>/dev/null && return 0
  mkdir -p "$ROOT/legacy" || return 1
  mv -f "$1" "$ROOT/legacy/$(basename "$1").$(date +%s 2>/dev/null || echo old)" || return 1
  log "guardado em $ROOT/legacy: $1"
}

integrate() {
  data=$(abs_or "${XDG_DATA_HOME:-}" "$HOME/.local/share")
  bin="$HOME/.local/bin"
  apps="$data/applications"
  launcher="$ROOT/current/salinha-launcher"
  mkdir -p "$bin" "$apps" || return 1
  [ -f "$ROOT/current/salinha.png" ] && cp -f "$ROOT/current/salinha.png" "$ROOT/icon.png"

  backup_foreign "$bin/salinha" || return 1
  tmp="$bin/.salinha.$$"
  {
    echo '#!/bin/sh'
    echo '# X-Salinha-Managed: gerado pela Salinha (salinha-launcher --integrate)'
    printf 'exec %s "$@"\n' "$(shquote "$launcher")"
  } >"$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$bin/salinha" || return 1

  backup_foreign "$apps/salinha.desktop" || return 1
  tmp="$apps/.salinha.desktop.$$"
  {
    echo '[Desktop Entry]'
    echo 'Type=Application'
    echo 'Name=Salinha'
    echo 'Comment=Servidores, canais de texto e voz'
    printf 'Exec=%s %%U\n' "$(desktop_quote "$launcher")"
    printf 'Icon=%s\n' "$ROOT/icon.png"
    echo 'Terminal=false'
    echo 'StartupWMClass=Salinha'
    echo 'Categories=Network;Chat;'
    echo 'X-Salinha-Managed=true'
  } >"$tmp" && mv -f "$tmp" "$apps/salinha.desktop" || return 1
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$apps" >/dev/null 2>&1
  log "integrado: $bin/salinha e $apps/salinha.desktop -> $(readlink "$ROOT/current")"
  return 0
}

# Já há uma Salinha aberta (trava de instância única do Electron, em
# ~/.config/Concord)? Então esta partida não é uma tentativa de abrir a
# versão nova: só traz a janela existente.
already_running() {
  config=$(abs_or "${XDG_CONFIG_HOME:-}" "$HOME/.config")
  lock=$(readlink "$config/Concord/SingletonLock" 2>/dev/null) || return 1
  pid=${lock##*-}
  case "$pid" in '' | *[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null
}

# A atualização grava boot-pending; o app novo apaga ao abrir. Se a versão
# nova não abriu em FAILED_BOOTS partidas, volta para a anterior, anota a
# versão em bad-versions e apaga os arquivos dela (pasta e download) para o
# app não reinstalá-la sozinho.
rollback_if_stuck() {
  pending="$ROOT/boot-pending"
  [ -f "$pending" ] || return 0
  already_running && return 0
  echo x >>"$pending" 2>/dev/null || return 0
  tries=$(($(wc -l <"$pending") - 1))
  [ "$tries" -gt "$FAILED_BOOTS" ] || return 0
  bad=$(head -n 1 "$pending")
  prev=$(readlink "$ROOT/previous" 2>/dev/null) || prev=''
  if [ -n "$prev" ] && [ -x "$ROOT/$prev/salinha" ] && [ "$prev" != "versions/$bad" ]; then
    log "versão $bad não abriu em $((tries - 1)) tentativas: voltando para $prev"
    relink "$prev" "$ROOT/current"
    rm -f "$ROOT/previous"
    case "$bad" in
    *[!0-9.]* | '') ;;
    *)
      printf '%s\n' "$bad" >>"$ROOT/bad-versions"
      rm -rf "$ROOT/versions/$bad" "$ROOT/downloads/Salinha-$bad-x64.tar.gz" \
        "$ROOT/downloads/Salinha-$bad-x64.tar.gz.part"
      ;;
    esac
  fi
  rm -f "$pending"
}

# Pode usar o sandbox de user namespaces? Senão, SANDBOX_OFF diz o motivo.
SANDBOX_OFF=''
userns_available() {
  case "${SALINHA_SANDBOX:-auto}" in
  0 | no | off)
    SANDBOX_OFF=forced
    return 1
    ;;
  1 | yes | on) return 0 ;;
  esac
  v=$(cat "$PROC_SYS/kernel/unprivileged_userns_clone" 2>/dev/null) && [ "$v" = 0 ] && SANDBOX_OFF=userns-off && return 1
  v=$(cat "$PROC_SYS/user/max_user_namespaces" 2>/dev/null) && [ "$v" = 0 ] && SANDBOX_OFF=userns-off && return 1
  v=$(cat "$PROC_SYS/kernel/apparmor_restrict_unprivileged_userns" 2>/dev/null) && [ "$v" = 1 ] && {
    # Perfil da Salinha instalado: vale para o binário dela, não para este
    # shell (então nada de testar com unshare aqui).
    grep -qF "\"$ROOT/versions/*/salinha\"" "$APPARMOR_D/salinha" 2>/dev/null && return 0
    SANDBOX_OFF=apparmor
    return 1
  }
  if command -v unshare >/dev/null 2>&1; then
    unshare -Ur true >/dev/null 2>&1 || {
      SANDBOX_OFF=userns-blocked
      return 1
    }
  fi
  return 0
}

if [ "${1:-}" = "--integrate" ]; then
  integrate
  exit $?
fi

rollback_if_stuck
APP="$ROOT/current/salinha"
if [ ! -x "$APP" ]; then
  echo "Salinha: instalação incompleta em $ROOT — rode o instalador de novo." >&2
  exit 1
fi
set -- --ozone-platform-hint=auto "$@"
if ! userns_available; then
  log "user namespaces indisponíveis ($SANDBOX_OFF): abrindo sem o sandbox do Chromium"
  SALINHA_SANDBOX_OFF=$SANDBOX_OFF
  export SALINHA_SANDBOX_OFF
  set -- --no-sandbox "$@"
fi
exec "$APP" "$@"
