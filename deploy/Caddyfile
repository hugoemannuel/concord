# /etc/caddy/Caddyfile da VPS — cópia versionada, com os blocos que estão no
# ar. O deploy (scripts/deploy-vps.sh) NÃO envia este arquivo.
#
# ┌─ COMO APLICAR (leia antes) ───────────────────────────────────────────────┐
# │ 1. Antes: backend com /healthz no ar (um deploy desta versão) e o socket  │
# │    do systemd ativo (docs/HOSPEDAGEM.md, "Porta do backend com o          │
# │    systemd"). As portas são as do /opt/concord/.env: 8090 = PORT do       │
# │    backend (= ListenStream do concord-server.socket), 7880 = LIVEKIT_PORT.│
# │ 2. Com ninguém em chamada (o script confere): o reload que muda os        │
# │    reverse_proxy fecha os WebSockets abertos na config antiga se ela não  │
# │    tinha stream_close_delay (chat reconecta sozinho; quem está em chamada │
# │    perde a sinalização um instante e o app reconecta a chamada).          │
# │ 3. Use scripts/apply-caddyfile.sh root@IP deploy/Caddyfile: valida,       │
# │    confere /healthz e que ninguém está em chamada, guarda backup,         │
# │    recarrega, testa /rtc, a API e /updates e volta o backup se falhar.    │
# │ Feito para o Caddy 2.11 do repositório oficial (stream_close_delay exige  │
# │ 2.7+; o 2.6.2 do Debian recusa este arquivo).                             │
# └───────────────────────────────────────────────────────────────────────────┘
#
# Por que funciona sem perder requisição no deploy: a porta 8090 é do systemd
# (concord-server.socket) e não fecha quando o backend reinicia; o Caddy
# conecta na hora e a requisição espera na fila até o processo novo atender.
# O lb_try abaixo só entra se a porta estiver fechada de verdade (backend sem
# o socket, ou parado), e aí só ajuda requisição sem corpo.
#
# stream_close_delay: num reload, os WebSockets abertos (chat e sinalização do
# LiveKit) continuam na config antiga por até 12 h em vez de cair na hora; o
# cliente reconecta quando quiser e já cai na config nova. Parar ou reiniciar
# o Caddy ainda fecha tudo.

# Sinalização do LiveKit (/rtc, /rtc/v1, /rtc/validate…) direto para o
# LiveKit, sem passar pelo backend: reiniciar o backend não corta a
# sinalização, e o cliente não faz o "ICE restart" que travava voz e tela por
# ~1 s. O app já pede /rtc no mesmo endereço da API, então funciona sem
# atualizar o app. Todo bloco que serve o app precisa deste trecho.
(salinha_rtc) {
	handle /rtc* {
		reverse_proxy 127.0.0.1:7880 {
			stream_close_delay 12h
		}
	}
}

# Atualizações do app desktop (docs/adr/0028). Os manifestos (latest*.yml,
# poucas centenas de bytes) saem do disco: são eles que dizem qual é a versão
# atual. Os arquivos pesados (instaladores de ~120 MB, .blockmap, .sig) vão
# para a GitHub Release da mesma versão (o nome traz a versão), com 302 — o
# tráfego não passa pela VPS. Para voltar a servir tudo do disco (a cópia
# continua em /opt/concord/updates), apague as duas linhas do @release.
(salinha_updates) {
	handle /updates/* {
		@release path_regexp release ^/updates/(Salinha-([0-9]+\.[0-9]+\.[0-9]+)-[A-Za-z0-9._-]+)$
		redir @release https://github.com/hugoemannuel/concord/releases/download/v{re.release.2}/{re.release.1} 302
		uri strip_prefix /updates
		root * /opt/concord/updates
		file_server
	}
}

# Backend (API, WebSocket do chat).
(salinha_backend) {
	reverse_proxy 127.0.0.1:8090 {
		# Reload não derruba o WebSocket do chat (ver o cabeçalho).
		stream_close_delay 12h
		# Porta fechada de verdade (backend parado): tenta de novo por até
		# 15 s em vez de 502. No reinício normal a porta não fecha (socket).
		lb_try_duration 15s
		lb_try_interval 100ms
		# Sem reaproveitar conexões: no desligamento o backend fecha as
		# ociosas, e um POST mandado numa delas daria 502. Conexão nova a cada
		# requisição é barato em 127.0.0.1.
		transport http {
			keepalive off
		}
	}
}

# App desktop completo: sinalização, atualizações e o resto no backend.
(salinha_app) {
	import salinha_rtc
	import salinha_updates
	handle {
		import salinha_backend
	}
}

# PUBLIC_URL dos apps desktop.
74-0-5-252.sslip.io {
	import salinha_app
}

# O bloco `:8080` (HTTP puro, repasse do playit) saiu em 2026-10-31: sem uso
# (docs/HOSPEDAGEM.md, "Portas abertas na VPS"). Tudo passa por HTTPS.

# Página de download (atrás do proxy do Cloudflare).
salinha.bhrx.com.br {
	encode zstd gzip
	import salinha_updates
	handle {
		root * /opt/concord/site
		file_server
	}
}

# Endereço antigo da página.
concord.bhrx.com.br {
	redir https://salinha.bhrx.com.br{uri} permanent
}

# App no navegador. DNS com o proxy do Cloudflare DESLIGADO (nuvem cinza): o
# Caddy vê o IP de verdade de quem conecta e o passa no X-Forwarded-For, que é
# a chave dos limites por IP do backend (prévia do convite, login, cadastro,
# confirmação de e-mail e senha). Se um dia ligar o proxy aqui, configure antes
# no bloco global `servers { trusted_proxies static <faixas do Cloudflare> }`
# para o X-Forwarded-For trazer o cliente real; sem isso todo mundo cai nos
# poucos IPs do Cloudflare e divide os mesmos limites. Não confie no
# CF-Connecting-IP de qualquer origem.
app-salinha.bhrx.com.br {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Chamadas: sinalização direto no LiveKit (antes do @backend).
	import salinha_rtc

	# Atualizações do app desktop: este domínio é o endereço alternativo
	# embutido no app (SERVER_FALLBACK_URLS); quem cai nele se atualiza por aqui.
	import salinha_updates

	# Backend: API (inclui os arquivos do chat em /api/media) e WebSocket do
	# chat. O reverse_proxy repassa o upgrade de WS.
	@backend path /api /api/* /ws
	handle @backend {
		import salinha_backend
	}

	# Arquivos com hash no nome: cache longo. Arquivo que não existe é 404
	# (não cai no index.html).
	handle /assets/* {
		root * /opt/concord/web
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# O resto é o app: qualquer rota (/servers/…, /dm/…, os links de convite
	# /convite/…) devolve o index.html,
	# sempre revalidado para pegar a versão nova logo depois do deploy.
	handle {
		root * /opt/concord/web
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
