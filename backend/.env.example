# Copie este arquivo para `.env` e ajuste os valores.
#   cp .env.example .env
#
# O arquivo `.env` é ignorado pelo Git — nunca o commite.
# O mesmo arquivo é lido pelo backend Go e pelo `docker compose`.

# Porta HTTP/WebSocket do backend (é ela que vai no túnel TCP do playit).
PORT=8080
# Endereço de escuta. Vazio = todas as interfaces (playit/LAN). Numa VPS com
# Caddy na frente, use 127.0.0.1 para o backend não ficar exposto sem HTTPS.
HOST=

# Proxies cujo X-Forwarded-For vale para o IP do cliente (log e limite de
# tentativas de login). Vazio = automático: com HOST=127.0.0.1 (Caddy na mesma
# máquina) confia só no loopback; com qualquer outro HOST (playit/LAN) não
# confia em ninguém. Ou uma lista de IPs/CIDRs separados por vírgula, ou "none".
TRUSTED_PROXIES=

# Porta do Postgres no host (troque se a 5432 já estiver em uso).
POSTGRES_PORT=5432

# Conexão com o PostgreSQL (as migrations são aplicadas automaticamente no boot).
DATABASE_URL=postgres://concord-user:concord-password@localhost:5432/concord?sslmode=disable

# Segredo usado para assinar os tokens JWT (access + refresh).
# Gere um valor forte e único, por exemplo:
#   openssl rand -hex 32
# Obrigatório: sem ele, com menos de 32 caracteres ou com este valor de
# exemplo, o backend não sobe (scripts/server-up.sh gera um no PC de dev).
JWT_SECRET=troque-por-um-segredo-forte-aqui

# ─── LiveKit (servidor de mídia das chamadas) ───────────────────
# Chave/segredo compartilhados entre o backend e o LiveKit.
#   openssl rand -hex 32
LIVEKIT_API_KEY=concord
LIVEKIT_API_SECRET=troque-por-um-segredo-forte-de-32-caracteres-ou-mais

# Porta HTTP interna do LiveKit. O backend faz proxy de /rtc para ela,
# então ela NÃO precisa de túnel.
LIVEKIT_PORT=7880

# Portas de mídia. Precisam ser IGUAIS às portas públicas que o playit
# atribuir aos túneis (TCP e UDP), porque o LiveKit anuncia a própria porta.
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882

# IP público do túnel do playit (PC de casa). Vazio = o LiveKit usa o IP da
# própria máquina: é o certo para dev/LAN e para VPS com IP público. NÃO
# preencha numa VPS: com o IP fixo o LiveKit passou a ignorar o ICE por IPv4
# (só quem tem IPv6 entrava na call). Veja docs/HOSPEDAGEM.md.
LIVEKIT_NODE_IP=

# Porta das métricas (Prometheus) do LiveKit, só em 127.0.0.1. O backend lê
# a cada minuto (observabilidade das lives, docs/OBSERVABILIDADE.md). Mudar a
# porta exige recriar o LiveKit (scripts/deploy-vps.sh --infra).
LIVEKIT_PROMETHEUS_PORT=6789

# Endereço público do backend (túnel TCP do playit). Usado por
# scripts/playit-watchdog.sh para reiniciar o playit se o túnel cair.
PUBLIC_URL=

# Endereço público do backend, sem barra no fim (ex.: https://api.exemplo.com).
# Com ele as imagens das propostas entram na issue do GitHub; vazio = a issue sai sem imagens.
API_PUBLIC_URL=

# ─── E-mail (confirmação de e-mail e recuperação de senha) ──────
# Endereço PÚBLICO do app web, usado nos links dos e-mails (/verify-email e
# /reset-password). Sem barra no fim.
APP_URL=http://localhost:5173
# SMTP. Com SMTP_HOST ou MAIL_FROM vazios os e-mails só aparecem no log do
# backend (bom para dev). Porta 465 = TLS direto; as outras usam STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente, ex.: Salinha <nao-responder@seudominio.com>
MAIL_FROM=

# Pasta servida em /updates/ (atualização automática do app). Relativa ao
# diretório do backend. scripts/release-win.sh publica aqui.
UPDATES_DIR=updates

# Pasta da mídia do chat. Relativa ao diretório do backend. Na VPS fica em
# /opt/concord/uploads e o deploy nunca mexe nela.
# UPLOADS_DIR=uploads

# Abaixo desse espaço livre (GB) no disco do UPLOADS_DIR o servidor recusa
# uploads novos (o mesmo disco tem o Postgres e os instaladores).
UPLOADS_MIN_FREE_GB=5

# ─── Maestro (bot de música) ────────────────────────────────────
# Precisa de yt-dlp e ffmpeg no PATH (scripts/install-services.sh instala).
# Sem eles o backend sobe normalmente e o Maestro responde "fora do ar".
# MUSIC_MAX_PLAYERS=5          # canais de voz tocando ao mesmo tempo
# MUSIC_QUEUE_MAX=100          # músicas por fila
# MUSIC_IDLE_TIMEOUT=5m        # sem música por esse tempo, o Maestro sai
# MUSIC_CACHE_DIR=             # padrão: pasta temporária do sistema/concord-music
# Opcional: cookies de uma conta YouTube Premium (formato 774, ~256 kbps).
# Exporte em uma janela anônima; eles expiram e precisam ser renovados.
# MUSIC_YT_COOKIES=/caminho/para/cookies.txt
# Opcional: provedor de PO token (bgutil em modo HTTP, ver docker-compose).
# MUSIC_POT_URL=http://127.0.0.1:4416
# Só para testes/e2e: tons do ffmpeg no lugar do YouTube.
# MUSIC_TEST_SOURCE=1

# Propostas (quadro de melhorias). Aprovadas na votação viram issue no GitHub.
# GITHUB_REPO: repositório das issues (owner/repo).
# Credencial, na ordem de preferência (sem nenhuma, as aprovadas ficam sem issue):
#  1. GitHub App (as issues saem como "<app>[bot]"): GITHUB_APP_ID, o id da
#     instalação (número no fim da URL de Install App) e o caminho do .pem
#     gerado no App (permissão Issues: Read and write; chmod 600).
#  2. GITHUB_TOKEN: token fixo (pessoal ou de uma conta robô, Issues: write).
# GITHUB_API_URL: só para GitHub Enterprise ou testes (padrão api.github.com).
# TECH_TEAM_USER_IDS: ids (csv) de quem move os cards depois da votação.
GITHUB_REPO=owner/repo
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_TOKEN=
# GITHUB_API_URL=
TECH_TEAM_USER_IDS=

# CHANGELOG_TOKEN: segredo com que o deploy publica as notas de cada versão
# (PUT /api/changelog/:versão). Vazio = publicação desligada (a leitura segue).
# Em produção vem do secret do GitHub de mesmo nome (scripts/deploy-vps.sh).
CHANGELOG_TOKEN=

# GIPHY_API_KEY: chave da API do GIPHY (developers.giphy.com, gratuita) para a
# aba de GIFs do seletor. Vazio = a aba fica sem GIFs ("Nenhum GIF encontrado").
GIPHY_API_KEY=

# SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET: app do Spotify for Developers
# (client credentials, sem login de ninguém) para o "Ouvir no Spotify" da
# atividade de música abrir a faixa. Vazio = o Spotify fica no link de busca
# (Apple Music, Deezer e YouTube não precisam de chave). docs/adr/0033.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
