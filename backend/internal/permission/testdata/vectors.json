    {"name": "administrador só pelo @everyone não age sobre membro sem cargo (mesma posição)", "owner_id": "dono", "actor": "admin", "target": "ana", "actor_highest": 0, "target_highest": 0, "expect": false},
    {"name": "ninguém age sobre si mesmo", "owner_id": "dono", "actor": "ana", "target": "ana", "actor_highest": 3, "target_highest": 3, "expect": false},
    {"name": "cargo mais alto age", "owner_id": "dono", "actor": "mod", "target": "ana", "actor_highest": 2, "target_highest": 1, "expect": true},
    {"name": "mesma posição não age", "owner_id": "dono", "actor": "mod", "target": "ana", "actor_highest": 2, "target_highest": 2, "expect": false},
    {"name": "abaixo não age", "owner_id": "dono", "actor": "mod", "target": "ana", "actor_highest": 1, "target_highest": 3, "expect": false}
  ],
  "can_manage_role": [
    {"name": "dono gerencia qualquer cargo", "is_owner": true, "actor_highest": 0, "role_position": 10, "expect": true},
    {"name": "cargo abaixo do seu", "is_owner": false, "actor_highest": 3, "role_position": 2, "expect": true},
    {"name": "o próprio cargo mais alto não", "is_owner": false, "actor_highest": 3, "role_position": 3, "expect": false},
    {"name": "cargo acima não", "is_owner": false, "actor_highest": 3, "role_position": 4, "expect": false},
    {"name": "@everyone com qualquer cargo", "is_owner": false, "actor_highest": 1, "role_position": 0, "expect": true},
    {"name": "só @everyone não gerencia nem o @everyone", "is_owner": false, "actor_highest": 0, "role_position": 0, "expect": false}
  ],
  "can_edit_roles_of": [
    {"name": "o dono mexe nos próprios cargos", "owner_id": "dono", "actor": "dono", "target": "dono", "expect": true},
    {"name": "o dono mexe nos cargos dos outros", "owner_id": "dono", "actor": "dono", "target": "ana", "expect": true},
    {"name": "ninguém mais mexe nos cargos do dono", "owner_id": "dono", "actor": "admin", "target": "dono", "expect": false},
