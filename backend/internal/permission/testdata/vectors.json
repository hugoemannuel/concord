  ],
  "can_grant": [
    {"name": "dá o que tem", "actor": ["VIEW_CHANNEL", "SEND_MESSAGES", "MANAGE_ROLES"], "changed": ["SEND_MESSAGES"], "expect": true},
    {"name": "não dá o que não tem", "actor": ["VIEW_CHANNEL", "MANAGE_ROLES"], "changed": ["SEND_MESSAGES", "VIEW_CHANNEL"], "expect": false},
    {"name": "administrador dá qualquer coisa", "actor": ["ADMINISTRATOR"], "changed": ["BAN_MEMBERS", "KICK_MEMBERS"], "expect": true},
    {"name": "não mexer em nada sempre pode", "actor": [], "changed": [], "expect": true}
  ]
}
